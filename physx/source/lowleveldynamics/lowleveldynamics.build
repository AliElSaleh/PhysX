Assembly LowLevelDynamics_static_64
Type     static_lib

include ../../common.buildvars

SourceDirectory       src
IntermediateDirectory ../../int/%_FileName
BuildDirectory        ../../Build/%Mode

Compiler.Flags        $PxCompilerFlags
Linker.Flags          $PxLinkerFlags
Defines               $PxSharedDefines PX_PHYSX_STATIC_LIB
Defines:windows       $PxWindowsDefines _LIB

Includes.Public
[
    include
]

Includes
[
    src
    include
    common/include
    ../lowlevel/api/include
    ../lowlevel/common/include
    ../lowlevel/common/include/pipeline
    ../lowlevel/common/include/utils
    ../lowlevel/software/include
    ../../../pxshared/include
    ../../include
    ../common/src
    ../foundation/include
    ../geomutils/include
    ../geomutils/src
    ../geomutils/src/contact
    ../physx/include
]