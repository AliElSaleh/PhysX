Assembly PhysXCommon_64
Type     shared_lib

include ../common.buildvars

IntermediateDirectory      ../int/%_FileName
BuildDirectory             ../Build/%(Mode)

SourceDirectories          common geomutils compiler

Compiler.Flags             $PxCompilerFlags
Linker.Flags               $PxLinkerFlags
Linker.Flags:windows       /DELAYLOAD:"PhysXFoundation_64.dll"

if windows
{
    SourceDirectories.Exclude */unix */linux
    SourceFiles.Exclude       *Linux.cpp
}
else
{
    SourceDirectories.Exclude */windows
    SourceFiles.Exclude       *Windows.cpp
}

SourceDirectories.Exclude compiler/resource_x64
SourceDirectories.Exclude compiler/resource_x86

SourceFiles.Exclude PhysX.rc PhysXCooking.rc PhysXFoundation.rc

Includes.Public common/include common/src
Includes
[
    common/include
    common/src
    ../../pxshared/include
    ../include
    foundation/include
    geomutils/src
    geomutils/src/convex
    geomutils/include
    geomutils/include
    geomutils/src
    geomutils/src/common
    geomutils/src/gjk
    geomutils/src/convex
    geomutils/src/hf
    geomutils/src/ccd
    geomutils/src/contact
    geomutils/src/cooking
    geomutils/src/distance
    geomutils/src/intersection
    geomutils/src/mesh
    geomutils/src/pcm
    geomutils/src/sweep
]

Libraries          %_NativeLibs PhysXFoundation_64
Library.Paths      ../Build/%Mode

Defines            $PxSharedDefines PX_PHYSX_COMMON_EXPORTS PhysXCommon_EXPORTS
Defines:windows    $PxWindowsDefines _WINDLL
