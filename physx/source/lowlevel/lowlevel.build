Assembly LowLevel_static_64
Type     static_lib

include ../../common.buildvars

IntermediateDirectory  ../../int/%_FileName
BuildDirectory         ../../Build/%Mode

Compiler.Flags         $PxCompilerFlags
Linker.Flags           $PxLinkerFlags
Linker.Subsystem       console
Defines                $PxSharedDefines
Defines:windows        $PxWindowsDefines _LIB

Includes.Public
[
    api/include
    software/include
    common/include
]

Includes
[
    common/include
    common/include/pipeline
    common/include/collision
    common/include/utils
