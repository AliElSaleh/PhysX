Assembly PhysXVehicle_static_64
Type     static_lib

include ../../common.buildvars

SourceDirectory       src
IntermediateDirectory ../../int/%_FileName
BuildDirectory        ../../Build/%(Mode)

Compiler.Flags        $PxCompilerFlags
Linker.Flags          $PxLinkerFlags
Defines               $PxSharedDefines PX_PHYSX_STATIC_LIB
Defines:windows       $PxWindowsDefines _LIB

Includes
[
    include
    src
    src/physxmetadata/include
    ../../../pxshared/include
    ../../include
    ../../include
    ../common/include
    ../common/src
    ../foundation/include
    ../foundation/include
    ../filebuf/include
    ../pvd/include
    ../physx/src
    ../physxmetadata/core/include
    ../physxmetadata/extensions/include
    ../physxextensions/src/serialization/Xml
]