Assembly PhysXFoundation_64
Type     shared_lib

include ../../common.buildvars

SourceDirectory       src
IntermediateDirectory ../../int/%_FileName
BuildDirectory        ../../Build/%(Mode)

Compiler.Flags        $PxCompilerFlags
Linker.Flags          $PxLinkerFlags
Libraries             %_NativeLibs
Defines               $PxSharedDefines PX_PHYSX_FOUNDATION_EXPORTS
Defines:windows       _WINDLL

if windows
{

    SourceDirectories.Exclude unix linux
    SourceFiles.Exclude       *Linux.cpp
}
else
{
    SourceDirectories.Exclude windows
    SourceFiles.Exclude       *Windows.cpp
}

Includes
[
    include
    ../../../pxshared/include
    ../../include
]

Includes.Public include
