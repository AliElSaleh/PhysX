option.mode(debug release)
Assert.WorkingDirectory .

if windows Compiler cl
if unix    Compiler clang++

if mode == debug   PxSharedDefines _DEBUG PX_DEBUG=1 PX_CHECKED=1 PX_SUPPORT_PVD=1 PX_NVTX=0
if mode == release PxSharedDefines NDEBUG PX_DEBUG=0 PX_CHECKED=0 PX_SUPPORT_PVD=0 PX_NVTX=0
if windows         PxWindowsDefines WIN32 WIN64 _CRT_SECURE_NO_DEPRECATE _CRT_NONSTDC_NO_DEPRECATE _WINSOCK_DEPRECATED_NO_WARNINGS _MBCS

if msvc
{
    PxCompilerFlags /Gd /GR- /GS- /fp:fast /wd4514 /wd4820 /wd4127 /wd4710 /wd4711 /wd4577 /wd4996

    if mode == release
    {
        PxCompilerFlags  /O2 /EHa /MT
        PxLinkerFlags    
    }

    if mode == debug
    {
        PxCompilerFlags  /Od /Oy /Z7 /MTd
        PxLinkerFlags    /DEBUG
    }
}

if clang
{
    PxCompilerFlags -fexceptions -Wno-invalid-offsetof

    if mode == release
    {
        PxCompilerFlags  -O3 
        PxLinkerFlags    
    }

    if mode == debug
    {
        PxCompilerFlags  -O0 -g3
        PxLinkerFlags    -g3
    }
}
