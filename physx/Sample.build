Assembly %app
.run

include common.buildvars

BuildDirectory        Build/%app/%Mode
IntermediateDirectory int/%app/%Mode

SourceDirectories
[
    samples/samplebase
    samples/sampleframework
    samples/pxtoolkit
    samples/samplecctsharedcode
    samples/sample%app
]

SourceDirectories.Exclude:windows */linux
SourceDirectories.Exclude:linux   */windows

if compiler == cl
{
    Compiler.Flags /EHsc
    Linker.Flags   /NODEFAULTLIB:LIBCMT
}

Includes
[
    include
    ../pxshared/include
    ../externals/targa/include
    ../externals/directx/include
    ../externals/atlmfc/include
    source/foundation/include
    source/fastxml/include
    source/physxmetadata/core/include
    source/common/src
    samples/pxtoolkit/include
    samples/samplebase
    samples/samplecctsharedcode
    samples/sampleframework/renderer/include
    samples/sampleframework/framework/include
    samples/sampleframework/platform/include
    samples/sample%app
]

Libraries
[
    PhysX_64
    PhysXFoundation_64
    PhysXCommon_64
    PhysXCooking_64
    FastXML_static_64
    LowLevel_static_64
    LowLevelAABB_static_64
    LowLevelDynamics_static_64
    Metadata-Core_static_64
    PhysXTask_static_64
    SceneQuery_static_64
    SimulationController_static_64
    PhysXPvdSDK_static_64
    PhysXExtensions_static_64
    PhysXVehicle_static_64
    PhysXCharacterKinematic_static_64
    targa
]

Library.Paths Build/%Mode ../externals/targa/bin

if mode == debug
{
    Defines _DEBUG
}
else
{
    Defines NDEBUG
}

if linux
{
    Includes ../externals/cg-linux/include

    Libraries X11 Xxf86vm Cg CgGL GL GLU GLEW glut
    Library.Paths ../externals/glew-linux/lib ../externals/cg-linux/lib

    PostBuild.Copy   ../externals/cg-linux/lib/libCg.so Build/Release
    PostBuild.Copy   ../externals/cg-linux/lib/libCgGL.so Build/Release
}

if windows
{
    Libraries msvcrt atls
    Library.Paths ../externals/atlmfc/lib/amd64

    Defines WIN64

    PostBuild.Copy ../physx/Build/%Mode/PhysX_64.dll           $BuildDirectory
    PostBuild.Copy ../physx/Build/%Mode/PhysXGpu_64.dll        $BuildDirectory
    PostBuild.Copy ../physx/Build/%Mode/PhysXDevice64.dll      $BuildDirectory
    PostBuild.Copy ../physx/Build/%Mode/PhysXCommon_64.dll     $BuildDirectory
    PostBuild.Copy ../physx/Build/%Mode/PhysXCooking_64.dll    $BuildDirectory
    PostBuild.Copy ../physx/Build/%Mode/PhysXFoundation_64.dll $BuildDirectory
}

Assert.Platform Windows Linux
Platform.macOS.ErrorMessage
{
    The sample demo apps cannot be built nor run on macOS
}

Assert.Program:linux xterm
Program.xterm.ErrorMessage
{
    Running the sample demo apps requires the XTerm terminal emulator.

    XTerm can be installed through your package manager.

    Once installed, you may also need to install the "misc" fonts
     - xorg-fonts-misc
     then refresh the font cache (this process may be different between distros)
}

Depend ../physx.build | mode=%mode

option.app(HelloWorld LargeWorld NorthPole Submarine Vehicle Bridges CustomGravity)
